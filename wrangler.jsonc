{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omm-app",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  // OpenNext output — run `npx @opennextjs/cloudflare build` to generate .open-next
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "omm-db",
      "database_id": "e5f2d06d-d3c6-45d0-a18b-640545ef31f7"
    }
  ],
  // R2 TEMPORARILY REMOVED: account R2 not enabled yet (code: 10042).
  // Code does not reference R2/KV bindings yet — re-add after enabling R2:
  //   npx wrangler r2 bucket create omm-receipts && npx wrangler r2 bucket create omm-listings
  // "r2_buckets": [
  //   { "binding": "R2", "bucket_name": "omm-receipts" },
  //   { "binding": "R2_LISTINGS", "bucket_name": "omm-listings" }
  // ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "210ff21d02564efdaf4c77293060c483"
    }
  ],
  "vars": {
    "APP_URL": "https://omm.jobayergroup.com",
    "APP_NAME": "Our Mess Management",
    "NODE_ENV": "production"
  },
  "routes": [{ "pattern": "omm.jobayergroup.com/*", "zone_name": "jobayergroup.com" }],
  "env": {
    "staging": {
      "vars": {
        "APP_URL": "https://staging-omm.jobayergroup.com",
        "APP_NAME": "Our Mess Management",
        "NODE_ENV": "production"
      },
      "d1_databases": [{ "binding": "DB", "database_name": "omm-db-staging", "database_id": "0a449513-9cc3-4dcb-8946-2285c2b42b87" }],
      "kv_namespaces": [{ "binding": "KV", "id": "a50e9ec76a2d431ba85e6a2f3e6a6015" }]
    },
    "production": {
      "vars": {
        "APP_URL": "https://omm.jobayergroup.com",
        "APP_NAME": "Our Mess Management",
        "NODE_ENV": "production"
      },
      "d1_databases": [{ "binding": "DB", "database_name": "omm-db", "database_id": "e5f2d06d-d3c6-45d0-a18b-640545ef31f7" }],
      "kv_namespaces": [{ "binding": "KV", "id": "210ff21d02564efdaf4c77293060c483" }]
    }
  }
}
