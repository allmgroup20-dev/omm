# App
APP_URL=https://omm.jobayergroup.com
APP_NAME="Our Mess Management"
NODE_ENV=development

# Database - local sqlite path (D1 in production via wrangler binding)
DATABASE_URL=./data/omm.db

# Auth
AUTH_SECRET=replace-with-32-char-random-secret-change-in-production
AUTH_URL=http://localhost:3000

# Cloudflare (production only - set via wrangler secret put)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# R2 / KV bindings are configured in wrangler.jsonc; local ids replaced on deploy
# D1_DATABASE_ID=xxx
# KV_ID=xxx
# R2_BUCKET=omm-receipts
